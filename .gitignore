# ---- build output ----------------------------------------------------------
build/
dist/
*.obj
*.res
*.exe
*.pdb
*.ilk
*.exp
*.lib
*.map

# ---- python ----------------------------------------------------------------
__pycache__/
*.pyc

# ---- extracted Windows art (large; regenerate with tools/pe_extract.py) ----
assets/extracted/
assets/logs/

# ---- editor / os -----------------------------------------------------------
.vs/
.vscode/
*.user
Thumbs.db
desktop.ini

# ---- checked-in build output ----------------------------------------------
# release/ holds the built program and installer, kept in the repository on
# purpose so a binary can be fetched without a toolchain. Everything else
# under build/ and dist/ stays out.
!release/
!release/*.exe
!release/*.txt
!release/*.md
