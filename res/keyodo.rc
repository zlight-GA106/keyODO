/* ===========================================================================
 * keyodo.rc -- KeyODO resources.
 *
 * ENCODING
 *   Windows 98 SE is an ANSI platform: resources must be code page 936 (GBK),
 *   not UTF-16 and not UTF-8. This file is kept in UTF-8 for review, and the
 *   pragma below tells a modern rc.exe how to read it. For the Windows 98 SE
 *   era toolchain (MSVC 6 rc.exe, which ignores the pragma) convert first:
 *       python tools/to_cp936.py res/keyodo.rc
 *
 * All user-visible Chinese lives here. No .c file contains a non-ASCII byte,
 * so the sources cannot be corrupted by an editor guessing the wrong encoding.
 * ======================================================================== */

#pragma code_page(936)

#include <windows.h>
#include "resource.h"

/* ------------------------------------------------------------------- icon */
/* 16-colour ICO with 16x16 and 32x32 images and no alpha channel: a 32-bit
 * alpha icon renders as a black block on Windows 98 SE. */
IDI_KEYODO      ICON    "keyodo.ico"

/* ------------------------------------------------------------------- menu */
/* "&" marks the accelerator and is not displayed; the "(F)" in the caption is
 * part of the string, matching the Simplified-Chinese Windows convention. */
/* The dropdown menus are drawn by src/ui/menu.c and their text
 * lives in the string table below. There is deliberately no MENU
 * resource: a second copy of the item text would silently rot. */

IDM_MAIN ACCELERATORS
BEGIN
    "K",            IDM_SHOW_KPM,       VIRTKEY, CONTROL
    "T",            IDM_TM_MANUAL,      VIRTKEY, CONTROL
END

/* ===========================================================================
 * English. Every id here is exactly IDS_LANG_STRIDE above its Chinese twin;
 * src/i18n/i18n.c looks up id + stride when English is active and falls back to
 * the Chinese entry when a translation is missing. Adding another language is
 * one more block like this.
 * ======================================================================== */
STRINGTABLE DISCARDABLE
BEGIN
    IDS_LANG_ZH_EN            "中文"
    IDS_LANG_EN_EN            "English"

    IDS_APP_TITLE_EN          "KeyODO"

    IDS_MENU_FILE_EN          "&File"
    IDS_MENU_EDIT_EN          "&Edit"
    IDS_MENU_VIEW_EN          "&View"
    IDS_MENU_STATS_EN         "&Stats"
    IDS_MENU_HELP_EN          "&Help"

    IDS_GB_SPEED_EN           "Speed"
    IDS_GB_ODO_EN             "Odometer"
    IDS_GB_RATE_EN            "Rate"

    IDS_LBL_ODO_EN            "ODO:"
    IDS_LBL_TRIP_EN           "TRIP:"
    IDS_LBL_KPM_EN            "KPM:"
    IDS_LBL_MAX_EN            "MAX:"

    IDS_BTN_TRIP_EN           "Clear(C)"
    IDS_BTN_PEAK_EN           "Reset(R)"

    IDS_STATUS_READY_EN       "Ready"
    IDS_ABOUT_TITLE_EN        "About KeyODO"
    IDS_ABOUT_TEXT_EN         "KeyODO 0.2\n\nKeyboard odometer: counts keystrokes, WPM and KPM.\n\nOnly key press counts are kept; nothing you type is recorded."

    IDS_WIDGET_MENU_MAIN_EN   "Show main window(&M)"
    IDS_WIDGET_MENU_HIDE_EN   "Hide desktop gauge(&H)"
    IDS_WIDGET_MENU_EXIT_EN   "E&xit"
    IDS_FMT_SCALE_EN          "%d DPI  %d%%"

    IDS_MENU_EXIT_EN          "E&xit\tAlt+F4"
    IDS_MENU_RESET_TRIP_EN    "Clear TRIP(&T)\tCtrl+T"
    IDS_MENU_RESET_MAX_EN     "Reset peak WPM(&R)"
    IDS_MENU_WIDGET_EN        "Desktop gauge(&W)"
    IDS_MENU_KPM_EN           "Show KPM(&K)\tCtrl+K"
    IDS_MENU_GEAR_EN          "Gear display(&G)"
    IDS_MENU_AUTO_EN          "Automatic(&A)"
    IDS_MENU_MANUAL_EN        "Manual(&T)"
    IDS_MENU_TOPMOST_EN       "Always on top(&P)"
    IDS_MENU_WIN5_EN          "Last 5 seconds(&5)"
    IDS_MENU_WIN10_EN         "Last 10 seconds(&1)"
    IDS_MENU_WIN30_EN         "Last 30 seconds(&3)"
    IDS_MENU_ABOUT_EN         "About KeyODO(&A)..."

    IDS_MENU_TRAY_EN          "Show tray icon(&T)"
    IDS_MENU_AUTOSTART_EN     "Run at startup(&S)"
    IDS_MENU_LANG_EN          "Language(&L)"
    IDS_MENU_FIT_EN           "Fit to screen(&F)"
    IDS_TRAY_TIP_EN           "KeyODO keyboard odometer"
    IDS_MENU_TRAY_SHOW_EN     "Show main window(&M)"
    IDS_MENU_TRAY_HIDE_EN     "Hide desktop gauge(&H)"
    IDS_MENU_TRAY_EXIT_EN     "E&xit"
    IDS_AUTOSTART_FAIL_EN     "Could not update the run-at-startup setting. Check that this user may write to the registry."
    IDS_LANG_ZH            "中文"
    IDS_LANG_EN            "English"

    IDS_MENU_TRAY          "显示托盘图标(&T)"
    IDS_MENU_AUTOSTART     "开机自启(&S)"
    IDS_MENU_LANG          "语言(&L)"
    IDS_MENU_FIT           "适应屏幕(&F)"
    IDS_TRAY_TIP           "KeyODO 键盘里程表"
    IDS_MENU_TRAY_SHOW     "显示主窗口(&M)"
    IDS_MENU_TRAY_HIDE     "隐藏桌面仪表(&H)"
    IDS_MENU_TRAY_EXIT     "退出(&X)"
    IDS_AUTOSTART_FAIL     "无法写入开机自启设置。请检查当前用户对注册表的写入权限。"
END

