/* ---------------------------------------------------------------- version */
VS_VERSION_INFO VERSIONINFO
FILEVERSION     KEYODO_VERSION_NUM
PRODUCTVERSION  KEYODO_VERSION_NUM
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        /* 0804 = Simplified Chinese, 04B0 = Unicode code page slot */
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName",      "zlight-GA106"
            VALUE "FileDescription",  "KeyODO"
            VALUE "FileVersion",      KEYODO_VERSION_STR
            VALUE "InternalName",     "keyodo"
            VALUE "OriginalFilename", "keyodo.exe"
            VALUE "ProductName",      "KeyODO"
            VALUE "ProductVersion",   KEYODO_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
